{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    "customManagers:dockerfileVersions"
  ],
  "schedule": ["after 8pm on sunday"],
  "packageRules": [
    {
      "matchDatasources": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Odoo publishes dated builds (19.0-YYYYMMDD). Docker versioning reads the date as a compatibility suffix and never proposes a newer build, so treat the date as the patch version.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["odoo"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d{8})$"
    },
    {
      "description": "Group Non-Major updates for Dockerfiles by filename",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Non-major updates for {{packageFile}}"
    },
    {
      "description": "Group Major updates for Dockerfiles by filename",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["major"],
      "groupName": "Major updates for {{packageFile}}"
    },
    {
      "description": "Group Non-Major updates for Docker Compose by filename",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Non-major updates for {{packageFile}}"
    },
    {
      "description": "Group Major updates for Docker Compose by filename",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["major"],
      "groupName": "Major updates for {{packageFile}}"
    }
  ]
}
