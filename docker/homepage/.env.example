# Homepage environment. Copy to .env, fill in, then encrypt:
#   sops --input-type dotenv --output-type dotenv -e .env > .env.enc && rm .env
#
# Quoting: wrap a value in single quotes if it contains $ (Compose would otherwise expand it).
# A value must not contain a double quote or a backslash: it is pasted into "..." in the YAML.

# --- Core -------------------------------------------------------------------
# Base domain, as in docker/caddy (.env DOMAIN_NAME). Apps are linked as <app>.home.<domain>.
HOMEPAGE_VAR_DOMAIN=yourdomain.com

# Login for the dashboard itself. Secret must be at least 32 characters: openssl rand -base64 32
HOMEPAGE_AUTH_PASSWORD=change-me-to-a-long-unique-password
HOMEPAGE_AUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Media ------------------------------------------------------------------
# Jellyfin: Dashboard > Advanced > API Keys
HOMEPAGE_VAR_JELLYFIN_KEY=
# Seerr: Settings > General > API Key
HOMEPAGE_VAR_SEERR_KEY=
# Immich: Account Settings > API Keys (permission: server.statistics, created by an admin)
HOMEPAGE_VAR_IMMICH_KEY=

# --- Downloads (arr.vm) -----------------------------------------------------
# Radarr / Sonarr / Prowlarr / Bazarr: Settings > General > API Key
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_BAZARR_KEY=
# qBittorrent WebUI login (API keys need qBittorrent >= 5.2.0)
HOMEPAGE_VAR_QBITTORRENT_USERNAME=
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=

# --- Apps -------------------------------------------------------------------
# Filebrowser login (use a dedicated read-only user)
HOMEPAGE_VAR_FILEBROWSER_USERNAME=
HOMEPAGE_VAR_FILEBROWSER_PASSWORD=

# --- Network ----------------------------------------------------------------
# wg-easy v15 login
HOMEPAGE_VAR_WGEASY_USERNAME=
HOMEPAGE_VAR_WGEASY_PASSWORD=
# Tailscale: API access token (admin console > Settings > Keys) and the device ID of the
# subnet router (Machines > machine > Machine Details > ID, ends in CNTRL)
HOMEPAGE_VAR_TAILSCALE_DEVICE_ID=
HOMEPAGE_VAR_TAILSCALE_KEY=
# Cloudflare Tunnel: API token with only "Account > Cloudflare Tunnel > Read"
HOMEPAGE_VAR_CLOUDFLARED_ACCOUNT_ID=
HOMEPAGE_VAR_CLOUDFLARED_TUNNEL_ID=
HOMEPAGE_VAR_CLOUDFLARED_KEY=
# UniFi: API key of a local read-only admin (Settings > Control Plane > Integrations)
HOMEPAGE_VAR_UNIFI_KEY=
# Full URL OpenSpeedTest is served on (CERTBOT_DOMAIN in docker/openspeedtest)
HOMEPAGE_VAR_OPENSPEEDTEST_URL=https://speedtest.yourdomain.com

# --- Infrastructure ---------------------------------------------------------
# Proxmox API token with the PVEAuditor role. Token ID format: user@realm!tokenname
# https://gethomepage.dev/configs/proxmox/#create-token
HOMEPAGE_VAR_PROXMOX_TOKEN_ID=api@pam!homepage
HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET=
