# --- Runtime ---------------------------------------------------------------
TIMEZONE=Europe/Zurich
APP_BASE_URL=http://first-bite.lan:8080
# Other host names the app is reached by (LAN IP, VPN name), comma-separated.
# Requests for any other Host are refused, which blocks DNS rebinding.
# APP_BASE_URL's host and localhost are always allowed.
ALLOWED_HOSTS=

# --- Database ----------------------------------------------------------------
POSTGRES_USER=firstbite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=firstbite

# --- Scope -------------------------------------------------------------------
# BFS municipality numbers to watch (261 = City of Zurich).
SCOPE_BFS=261
# How far back date-window sources (SHAB, Amtsblatt, OSM) look on their first run.
BACKFILL_DAYS=90

# --- Radar rules ---------------------------------------------------------------
# Days an opened venue stays on the radar ("Just opened") before it is archived.
ARCHIVE_AFTER_DAYS=14
# Days an early signal (permit, registration) with no new evidence stays before it goes stale. 0 keeps it.
STALE_AFTER_DAYS=270
# Days an opening date that has passed (month, season...) stays "opening soon" before it counts as merely announced.
OPENING_GRACE_DAYS=14
# Days ahead an opening date may lie to count as "opening soon"; later dates stay in Early signals.
OPENING_SOON_DAYS=45
# Days a pop-up without an end date counts as running.
POPUP_MAX_DAYS=90
# Days a closed venue's address is watched for the next tenant.
ADDRESS_WATCH_DAYS=730

# --- Budgets (paid and rate-limited services, per run) --------------------------
# Instagram via Apify (billed per post): accounts per daily run (more take turns), posts per account for
# every INSTAGRAM_LOOKBACK_DAYS a turn covers (a turn that comes round later reads more, at most 10x),
# and the shortest window a turn covers in days. The run stats count accounts that filled their cap.
INSTAGRAM_MAX_ACCOUNTS=60
INSTAGRAM_POSTS_PER_ACCOUNT=8
INSTAGRAM_LOOKBACK_DAYS=3
# Google Places weekly sweep: the city as an n x n grid, result pages per cell and venue type.
# Requests per sweep = grid^2 x 5 types x pages at most.
PLACES_SWEEP_GRID=3
PLACES_SWEEP_PAGES=3
# The daily check keeps looking at an opened venue's listing for a closure this many days after it
# opened, once a week per listing (0: only while it is on the radar). One request per listing and week.
PLACES_CLOSURE_CHECK_DAYS=365
# Commercial register (Zefix) lookups per daily run.
ZEFIX_LOOKUPS_PER_RUN=25
# Brave attempts count before sending, including failures and manual scans.
BRAVE_SEARCH_DAILY_CAP=100
BRAVE_SEARCH_MONTHLY_CAP=3000

# --- LLM (OpenRouter, OpenAI-compatible) ---------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Ordered fallback list; free models rotate, check the Sources page.
LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free,openrouter/free
# OpenRouter free tier: 50 requests/day, or 1000/day after a one-time $10 credit purchase.
LLM_DAILY_REQUEST_CAP=900
# Upper bound on items per model request, and how long to wait for an answer.
# Evidence extraction caps short batches at 5 and isolates longer articles.
LLM_BATCH_SIZE=15
LLM_TIMEOUT_SECONDS=300
# openrouter | openai. Derived from LLM_BASE_URL when unset: anything other than
# openrouter.ai gets plain OpenAI-compatible requests (no fallback list).
# LLM_PROVIDER=
# A local model (see DEVELOPMENT.md, "Running a local model"), e.g. LM Studio on the Mac Studio:
#   LLM_BASE_URL=http://mac-studio.lan:1234/v1
#   LLM_API_KEY=
#   LLM_MODELS=qwen3.6-35b-a3b
#   LLM_TIMEOUT_SECONDS=300
#   LLM_DAILY_REQUEST_CAP=100000

# --- Keyed sources -------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
APIFY_TOKEN=
# Requires a Brave plan granting permission to retain search results.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_STORAGE_ALLOWED=false
# Public Zurich food event listings, twice daily; relevance is still reviewed.
EVENTFROG_ENABLED=true
# FoodFreaks' public Zurich pop-up calendar page, twice daily.
FOODFREAKS_CALENDAR_ENABLED=true
# Zefix PublicREST (commercial register lookups): free credentials on request from zefix@bj.admin.ch.
ZEFIX_USERNAME=
ZEFIX_PASSWORD=

# --- Official restaurant and operator pages --------------------------------------
# Public home, news or careers pages and news feeds to watch daily for announcements,
# comma separated, each optionally followed by |Operator name. Empty: none watched.
OFFICIAL_PAGES=

# --- Screenshot tips ------------------------------------------------------------
# Local Tesseract (with German and English) reads screenshot tips; the image never
# leaves the server and is not stored. The Docker image ships it.
OCR_ENABLED=true
OCR_COMMAND=tesseract

# --- Newsletter inbox (IMAP) and digest (SMTP) -----------------------------------
IMAP_ADDR=imap.example.com:993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_TLS=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
DIGEST_TO=
DIGEST_TIME=07:30
# Venues listed per digest section (the rest is a count), and for early signals.
DIGEST_MAX_PER_SECTION=20
DIGEST_MAX_EARLY_SIGNALS=8
# Days before an exact opening day the digest reminds you of a venue you watch
# (comma-separated, 0 = on the day; furthest first is not required).
DIGEST_REMINDER_DAYS=7,1
# How old a change of a watched opening may be to still be announced, in days.
DIGEST_CHANGE_NOTICE_DAYS=14
